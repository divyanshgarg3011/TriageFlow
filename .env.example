# Copy to .env and fill in. Without a key the app runs in demo mode (scripted offline model).
ANTHROPIC_API_KEY=

# Force demo mode even with a key (1 = on)
DEMO_MODE=0

# Models per agent (defaults shown)
TRIAGE_MODEL=claude-haiku-5-5
RESEARCH_MODEL=claude-sonnet-5-5
RESOLUTION_MODEL=claude-sonnet-5-5
QA_MODEL=claude-sonnet-5-5

# Policy gate thresholds, enforced in code
REFUND_AUTO_LIMIT=500
MIN_CONFIDENCE=0.6
MAX_RISK=0.6
MAX_REVISIONS=2

# How many tickets are processed at the same time
MAX_PARALLEL_RUNS=3
# Seconds of artificial delay per step in demo mode, so you can watch it
DEMO_STEP_DELAY=0.6
